// Greenwood School App — data model
// Multi-school ready: every core table carries schoolId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HOLIDAY
}

enum NoticeAudience {
  SCHOOL
  CLASS
}

enum LeaveType {
  SICK
  CASUAL
  OTHER
}

enum LeaveStatus {
  SUBMITTED
  APPROVED
  DECLINED
}

model School {
  id        Int      @id @default(autoincrement())
  name      String
  timezone  String   @default("Asia/Kolkata")
  logo      String?  @db.Text
  locality  String?
  city      String?
  createdAt DateTime @default(now())

  users        User[]
  students     Student[]
  classes      Klass[]
  subjects     Subject[]
  attendance   Attendance[]
  notices      Notice[]
  diaryEntries DiaryEntry[]
  leaveRequests LeaveRequest[]
  events       Event[]
  terms        Term[]
  albums       PhotoAlbum[]
  teachingAssignments TeachingAssignment[]
}

model User {
  id        Int      @id @default(autoincrement())
  // Null for SUPER_ADMIN (platform owner) — every other role is bound to a school.
  schoolId  Int?
  phone     String
  name      String
  role      Role
  createdAt DateTime @default(now())

  archivedAt   DateTime?
  archivedById Int?
  /// 0 while live; set to `id` on archive, so an archived teacher's mobile is
  /// free to reuse while live accounts still collide. See the note on
  /// Subject.archiveKey for why a nullable timestamp cannot do this job.
  archiveKey   Int @default(0)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // relations by role
  parentLinks     ParentStudentLink[]
  classesTaught   Klass[]             @relation("ClassTeacher")
  attendanceMarks Attendance[]        @relation("AttendanceMarkedBy")
  noticesCreated  Notice[]            @relation("NoticeCreatedBy")
  noticeAcks      NoticeAck[]
  diaryCreated    DiaryEntry[]        @relation("DiaryCreatedBy")
  diaryDone       DiaryDone[]
  leavesCreated   LeaveRequest[]      @relation("LeaveCreatedBy")
  leavesReviewed  LeaveRequest[]      @relation("LeaveReviewedBy")
  notifications   Notification[]
  teachingAssignments TeachingAssignment[] @relation("TeacherAssignments")

  @@unique([schoolId, phone, role, archiveKey])
  @@index([phone])
}

model OtpCode {
  id        Int       @id @default(autoincrement())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}

model Student {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  name        String
  admissionNo String
  dob         DateTime?
  createdAt   DateTime @default(now())

  /// A pupil who has left. Their marks, register and leave history stay exactly
  /// as they were; they simply stop appearing in rosters and pickers.
  /// No archiveKey: Student has no unique constraint to work around.
  archivedAt   DateTime?
  archivedById Int?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments   Enrollment[]
  parentLinks   ParentStudentLink[]
  attendance    Attendance[]
  diaryDone     DiaryDone[]
  leaveRequests LeaveRequest[]
  results       Result[]
  resultMeta    ResultMeta[]

  @@index([schoolId])
}

model Klass {
  id             Int    @id @default(autoincrement())
  schoolId       Int
  grade          String
  section        String
  classTeacherId Int?

  archivedAt   DateTime?
  archivedById Int?
  /// 0 while live, `id` once archived — see Subject.archiveKey.
  archiveKey   Int @default(0)

  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeacher User?  @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  enrollments  Enrollment[]
  diaryEntries DiaryEntry[]
  notices      Notice[]
  albums       PhotoAlbum[]
  teachingAssignments TeachingAssignment[]
  terms        Term[]

  @@unique([schoolId, grade, section, archiveKey])
}

model Subject {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  createdAt DateTime @default(now())

  /// Retired from the catalogue. The row stays forever — exams and marks point
  /// at it — but it is no longer offered when setting up new work.
  archivedAt   DateTime?
  archivedById Int?
  /// 0 while live; set to `id` on archive.
  ///
  /// MySQL has no partial unique indexes, and it treats NULLs in a unique index
  /// as distinct from each other. So adding the nullable `archivedAt` to the
  /// tuple below would stop it enforcing anything at all among live rows — two
  /// live subjects could both be called "Maths". A non-null integer is the only
  /// shape that works: 0 for every live row so they still collide with each
  /// other, and `id` (never 0, never repeated) for archived rows so they
  /// collide with nothing. Name-mangling the archived row instead would corrupt
  /// the very history we are preserving, since marks join on the name.
  archiveKey   Int @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  terms  Term[]

  @@unique([schoolId, name, archiveKey])
  @@index([schoolId])
}

model TeachingAssignment {
  id        Int @id @default(autoincrement())
  schoolId  Int
  teacherId Int
  klassId   Int
  subjectId Int

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Restrict: the timetable is not collateral damage of a catalogue tidy-up.
  // Retiring a teacher or subject archives it; the assignment is unpicked first.
  teacher User    @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  klass   Klass   @relation(fields: [klassId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, klassId, subjectId])
  // A subject in a class has one teacher, so the admin always knows who to ask
  // about it. Archiving a teacher deletes their rows, freeing the slot.
  @@unique([klassId, subjectId])
  @@index([schoolId])
  @@index([klassId])
  @@index([teacherId])
}

model Enrollment {
  id           Int    @id @default(autoincrement())
  studentId    Int
  klassId      Int
  academicYear String

  // Restrict on both: which class a child sat in, in which year, is history.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  klass   Klass   @relation(fields: [klassId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYear])
}

model ParentStudentLink {
  id           Int    @id @default(autoincrement())
  parentUserId Int
  studentId    Int
  relation     String @default("Parent")

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
}

model Attendance {
  id         Int              @id @default(autoincrement())
  schoolId   Int
  studentId  Int
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById Int?

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Restrict: a pupil leaving is not a reason to unwrite their register.
  student  Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // markedBy stays SetNull: no code path deletes a User (teachers are archived),
  // and the AuditLog snapshots the actor's name with no FK of its own.
  markedBy User?   @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([schoolId, date])
}

model Notice {
  id              Int            @id @default(autoincrement())
  schoolId        Int
  title           String
  body            String         @db.Text
  category        String         @default("General")
  pinned          Boolean        @default(false)
  audienceType    NoticeAudience @default(SCHOOL)
  audienceClassId Int?
  createdById     Int?
  createdAt       DateTime       @default(now())

  school         School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  audienceClass  Klass? @relation(fields: [audienceClassId], references: [id])
  createdBy      User?  @relation("NoticeCreatedBy", fields: [createdById], references: [id])

  acks NoticeAck[]

  @@index([schoolId, pinned])
}

model NoticeAck {
  id           Int      @id @default(autoincrement())
  noticeId     Int
  parentUserId Int
  ackAt        DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  parent User   @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  @@unique([noticeId, parentUserId])
}

model DiaryEntry {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  klassId     Int
  subject     String?  // null = a general "note for the day", not tied to a subject
  date        DateTime @db.Date
  task        String   @db.Text
  note        String?  @db.Text
  createdById Int?

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Restrict: homework set, and the parents who ticked it done, is history.
  klass     Klass  @relation(fields: [klassId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("DiaryCreatedBy", fields: [createdById], references: [id])

  done DiaryDone[]

  @@index([klassId, date])
}

model DiaryDone {
  id           Int      @id @default(autoincrement())
  diaryEntryId Int
  studentId    Int
  parentUserId Int
  doneAt       DateTime @default(now())

  diaryEntry DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     User       @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  @@unique([diaryEntryId, studentId])
}

model LeaveRequest {
  id             Int         @id @default(autoincrement())
  schoolId       Int
  studentId      Int
  type           LeaveType
  fromDate       DateTime    @db.Date
  toDate         DateTime    @db.Date
  reason         String      @db.Text
  status         LeaveStatus @default(SUBMITTED)
  createdByParentId Int
  reviewedById   Int?
  createdAt      DateTime    @default(now())

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Restrict: leave applied for and approved is a record of what happened.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy User    @relation("LeaveCreatedBy", fields: [createdByParentId], references: [id])
  reviewedBy User?  @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])

  @@index([schoolId, status])
}

model Event {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  title       String
  description String?  @db.Text
  date        DateTime @db.Date

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
}

model Term {
  id       Int    @id @default(autoincrement())
  schoolId Int
  // Null for legacy school-wide terms. A school-wide exam created from the UI
  // is fanned out as one row per class, so each class owns its own copy.
  klassId  Int?
  // Null = exam covers all subjects (graded per subject); set = single-subject test.
  subjectId Int?
  name     String

  /// Non-null mirrors of klassId/subjectId (NULL becomes 0).
  ///
  /// The unique below used to name the nullable columns directly, and MySQL
  /// treats NULLs in an index as distinct — so it never actually fired for the
  /// common shape (a school-wide, all-subjects exam), and `skipDuplicates` on
  /// the two create paths silently did nothing. Two exams with the same name
  /// could exist in one class, splitting that exam's marks across both.
  /// Both write sites set these alongside the real columns.
  klassKey   Int @default(0)
  subjectKey Int @default(0)

  archivedAt   DateTime?
  archivedById Int?
  /// 0 while live, `id` once archived — see Subject.archiveKey.
  archiveKey   Int @default(0)

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Restrict, NOT SetNull. These two used to Cascade, which made deleting a
  // subject or class silently destroy every mark under it (Term -> Result).
  // SetNull would be just as wrong: a null subjectId already means "covers all
  // subjects", so nulling it would relabel a historic single-subject test as an
  // all-subjects exam on the report card, and unlock grading of every subject.
  klass      Klass?       @relation(fields: [klassId], references: [id], onDelete: Restrict)
  subject    Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  results    Result[]
  resultMeta ResultMeta[]

  @@unique([schoolId, klassKey, name, subjectKey, archiveKey])
  @@index([klassId])
  @@index([subjectId])
}

model Result {
  id        Int    @id @default(autoincrement())
  studentId Int
  termId    Int
  subject   String
  score     Float
  maxScore  Float  @default(100)
  grade     String

  // Restrict on both: a mark is the record the whole platform exists to hold.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, subject])
}

model ResultMeta {
  id             Int     @id @default(autoincrement())
  studentId      Int
  termId         Int
  overallPct     Float
  rank           Int?
  teacherComment String? @db.Text

  // Restrict on both: overall %, rank and the teacher's comment are history too.
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId])
}

model PhotoAlbum {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  title     String
  // The day the album is about (sports day, field trip …), not when it was made.
  date      DateTime @db.Date
  coverUrl  String?
  klassId   Int?
  createdAt DateTime @default(now())

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  klass  Klass?  @relation(fields: [klassId], references: [id])
  photos Photo[]

  @@index([schoolId, date])
}

model Photo {
  id        Int      @id @default(autoincrement())
  albumId   Int
  url       String   @db.Text
  caption   String?
  createdAt DateTime @default(now())

  album PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?   @db.Text
  deeplink  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
  PURGE
  LOGIN
}

/// Append-only record of who changed what.
///
/// Deliberately carries no foreign keys: an audit trail that becomes unreadable
/// when its subject is purged is not an audit trail. The actor's name and the
/// target's label are snapshotted as text at write time, so a row still reads
/// correctly long after the user or subject it describes is gone.
model AuditLog {
  id        Int         @id @default(autoincrement())
  schoolId  Int?
  actorId   Int?
  actorName String      @db.VarChar(191)
  actorRole Role
  action    AuditAction
  /// Model name, e.g. "Subject", "Term", "Student".
  entity    String      @db.VarChar(40)
  entityId  Int
  /// The target's human name at the time, e.g. "Mathematics".
  label     String      @db.VarChar(191)
  /// What was preserved or affected, e.g. "312 marks across 4 exams retained".
  summary   String?     @db.Text
  before    Json?
  after     Json?
  ip        String?     @db.VarChar(45)
  createdAt DateTime    @default(now())

  @@index([schoolId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}
